# Database
POSTGRES_USER=jobsearcher
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jobsearcher
DATABASE_URL=postgresql+asyncpg://jobsearcher:changeme@postgres:5432/jobsearcher

# Redis
REDIS_URL=redis://redis:6379/0

# LLM Configuration
# Provider options: groq, ollama, openai, anthropic
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Groq (recommended - fast and high quality)
# Get your API key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# OpenAI (alternative)
# OPENAI_API_KEY=your-openai-api-key

# Anthropic (alternative)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Ollama (for local models - optional)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=B-A-M-N/vibethinker:1.5b

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=your-email@gmail.com

# API
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-this-secret-key

# Frontend
# Leave unset for dynamic URL detection (recommended for Tailscale/remote access)
# The frontend auto-detects the backend URL based on current browser hostname
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# VPN Configuration (for gluetun - protects scraper IP)
# See https://github.com/qdm12/gluetun-wiki for all providers
# Common providers: nordvpn, protonvpn, mullvad, surfshark, expressvpn, custom
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=openvpn

# For custom OpenVPN: place your .ovpn file in infra/vpn/ and set:
# VPN_USER=your-vpn-username
# VPN_PASSWORD=your-vpn-password

# For NordVPN:
# VPN_SERVICE_PROVIDER=nordvpn
# VPN_USER=your-service-credentials-username
# VPN_PASSWORD=your-service-credentials-password

# For ProtonVPN:


# For Mullvad (Wireguard):
# VPN_SERVICE_PROVIDER=mullvad
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=your-private-key
# WIREGUARD_ADDRESSES=your-address
